# Public API base only — never put secrets in NEXT_PUBLIC_* vars.
# Include the /api/v1 suffix (origin-only values are tolerated at runtime,
# but the full base is canonical). Baked at BUILD time for client bundles.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# Server-only override, read live at RUNTIME (no rebuild needed). Use this in
# Docker/production so the BFF reaches the backend by its internal hostname:
# API_BASE_INTERNAL=http://backend:8000/api/v1
